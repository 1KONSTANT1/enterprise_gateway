{
  "display_name": "Python 3 GPU",
  "language": "python",
  "metadata": {
    "process_proxy": {
      "class_name": "enterprise_gateway.services.processproxies.k8s.KubernetesProcessProxy",
      "config": {
        "image_name": "10.100.203.151:443/library/jupyter-kernel-312:latest"
      }
    },
    "debugger": true
  },
  "env": {
    "KERNEL_NAMESPACE" : "default",
    "KERNEL_GPUS" : "1",
    "KERNEL_GPUS_LIMIT" : "1",
    "KERNEL_DEADLINE_SECONDS" : "21600",
    "KERNEL_MIG_PROFILE" : "mig-1g.20gb",
    "KERNEL_CPUS" : "2",
    "KERNEL_CPUS_LIMIT" : "2",
    "KERNEL_MEMORY" : "16G",
    "KERNEL_MEMORY_LIMIT" : "16G",
    "KERNEL_LAUNCH_TIMEOUT" : "600"

},
  "argv": [
    "python3",
    "/opt/launch_kubernetes.py",
    "--RemoteProcessProxy.kernel-id",
    "{kernel_id}",
    "--RemoteProcessProxy.response-address",
    "{response_address}",
    "--RemoteProcessProxy.public-key",
    "{public_key}",
    "--RemoteProcessProxy.port-range",
    "{port_range}",
    "--RemoteProcessProxy.spark-context-initialization-mode",
    "none"
  ]
}

