class CustomLDAPAuthenticator(LDAPAuthenticator):
    def normalize_username(self, username):
        # Вызываем родительский метод для базовой нормализации (например, приведение к нижнему регистру)
        username = super().normalize_username(username)
        # Заменяем точку на нужный символ (например, подчеркивание)
        return username.replace('.', '-')
